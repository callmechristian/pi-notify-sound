{
  "name": "pi-notify-sound",
  "version": "0.1.0",
  "description": "Pi extension — plays a sound when the agent finishes and when it waits for your input (questions, permission prompts).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-extension",
    "pi-package",
    "notify",
    "sound"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callmechristian/pi-notify-sound.git"
  },
  "engines": {
    "node": ">=18"
  }
}
